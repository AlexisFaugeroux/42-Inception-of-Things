Vagrant.configure("2") do |config|
  # Configuration commune aux deux VMs
  config.vm.box = "boxomatic/alpine-3.24"
  config.vm.box_version = "20260930.0.1"

  config.vm.provision "shell", inline: <<-SHELL
    apk update
    apk add curl
    apk add iptables
  SHELL
  
  # Configuration de la VM
  config.vm.define "afaugeroS" do |server|
    server.vm.hostname = "afaugeroS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.synced_folder "./conf", "/home/vagrant/conf"

    server.vm.provider "libvirt" do |libvirt|
      libvirt.default_prefix = ""
      libvirt.memory = 1024
      libvirt.cpus = 1

      libvirt.memorybacking :source, :type => "memfd"
      libvirt.memorybacking :access, :mode => "shared"
    end

    server.vm.provision "file",
      source: "./www",
      destination: "/home/vagrant/www"

    server.vm.provision "shell",
      path: "scripts/server.sh"

    server.vm.provision "shell",
      path: "scripts/deploy.sh"
  end
end
